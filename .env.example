# Integración con Sanity (copia este archivo como .env.local)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
VITE_SANITY_USE_CDN=true

# Opcional: token de escritura para guardar las solicitudes del formulario
# de contacto como documentos "contactRequest" en Sanity.
VITE_SANITY_WRITE_TOKEN=
